-- QUERY - 5
SELECT o.OrderID,
       o.ShipName,
       o.ShipAddress,
       s.CompanyName AS ShippingCompany
FROM Orders o
JOIN Shippers s
    ON o.ShipVia = s.ShipperID
WHERE o.ShipCountry = 'Germany';

======================================================================================
-- QUERY - 6
SELECT o.OrderID,
       o.OrderDate,
       o.ShipName,
       o.ShipAddress
FROM Orders o
JOIN `Order Details` od
    ON o.OrderID = od.OrderID
JOIN Products p
    ON od.ProductID = p.ProductID
WHERE p.ProductName = 'Sasquatch Ale';

